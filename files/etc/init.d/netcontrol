#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/netcontrol daemon
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

stop_service() {
    /usr/sbin/netcontrol stop >/dev/null 2>&1
}

reload_service() {
    /usr/sbin/netcontrol apply
}
